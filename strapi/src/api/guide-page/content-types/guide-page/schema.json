{
  "kind": "collectionType",
  "collectionName": "guide_pages",
  "info": {
    "singularName": "guide-page",
    "pluralName": "guide-pages",
    "displayName": "Guide Page",
    "description": "Written guide pages (Welcome, Travel Tips, Handicrafts, events, services…). Blank lines in a section body separate paragraphs."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "group": {
      "type": "enumeration",
      "enum": ["visiting", "touring", "events", "services", "about"],
      "default": "about"
    },
    "intro": { "type": "text" },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "guide.section"
    },
    "sortOrder": { "type": "integer", "default": 0 }
  }
}
