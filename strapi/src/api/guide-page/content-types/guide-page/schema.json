{
  "kind": "collectionType",
  "collectionName": "guide_pages",
  "info": {
    "singularName": "guide-page",
    "pluralName": "guide-pages",
    "displayName": "Guide Page",
    "description": "Written guide pages. Blank lines in a section body separate paragraphs. Optional: featured places (with an optional 'distance from' place), related links, and a travel-agent list."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "group": {
      "type": "enumeration",
      "enum": [
        "visiting",
        "touring",
        "events",
        "services",
        "about"
      ],
      "default": "about"
    },
    "intro": {
      "type": "text"
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "guide.section"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageCredit": {
      "type": "string"
    },
    "featuredHeading": {
      "type": "string"
    },
    "featuredTours": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tour.tour"
    },
    "distanceFrom": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tour.tour"
    },
    "links": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    },
    "showTravelAgents": {
      "type": "boolean",
      "default": false
    }
  }
}
